{
  "styles": [
    "https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.2.0/github-markdown.min.css"
  ],
  "body_class": "markdown-body",
  "css": "body { padding: 20px; max-width: 1200px; margin: 0 auto; } img { max-width: 100%; height: auto; }",
  "marked_options": {
    "headerIds": false,
    "mangle": false
  },
  "pdf_options": {
    "format": "A4",
    "margin": {
      "top": "20mm",
      "right": "20mm",
      "bottom": "20mm",
      "left": "20mm"
    },
    "printBackground": true
  }
}

